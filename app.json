{
  "expo": {
    "name": "NotaSegura",
    "slug": "notasegura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icono_notasegura.jpg",
    "scheme": "notasegura",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./icono_notasegura.jpg",
        "backgroundImage": "./icono_notasegura.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.notasegura"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8723f988-8c79-448f-9c71-246c0b869cc6"
      }
    }
  }
}
